# Copy to backend/.env for local dev. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-in-dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Postgres via docker-compose. Omit to fall back to SQLite for quick unit tests.
DATABASE_URL=postgres://cni:cni_dev@127.0.0.1:5432/cni
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
